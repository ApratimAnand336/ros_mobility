<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobility_hw</name>
  <version>0.1.0</version>
  <description>Per-domain hardware adapters (mock, gazebo, unity, real CAN) for the mobility stack.</description>
  <maintainer email="mrt@example.com">MRT Mobility</maintainer>
  <license>BSD-3-Clause</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>mobility_core</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <!-- domain:=real with a real CAN bus also needs python3-can (pip install python-can); imported lazily -->
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
