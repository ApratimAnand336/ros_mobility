<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobility_bringup</name>
  <version>0.1.0</version>
  <description>Single launch file and per-domain configs for the mobility stack.</description>
  <maintainer email="mrt@example.com">MRT Mobility</maintainer>
  <license>BSD-3-Clause</license>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mobility_ros</exec_depend>
  <exec_depend>mobility_hw</exec_depend>
  <exec_depend>joy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
